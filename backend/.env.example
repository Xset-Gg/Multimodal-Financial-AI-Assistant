# ---------------------------------------------------------------------------
# SpendLens AI backend configuration. Copy to backend/.env and fill in values.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose exposes the db on port 5446 by default)
DATABASE_URL=postgresql+psycopg://spendlens:spendlens@localhost:5446/spendlens
# Used by the test suite only
TEST_DATABASE_URL=postgresql+psycopg://spendlens:spendlens@localhost:5446/spendlens_test

# Groq — powers vision extraction (images / scanned PDFs) and question interpretation.
# Without a key, text PDFs still work (Docling + deterministic parsing) and the assistant
# uses its rule-based interpreter; images and scanned pages cannot be processed.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90
VISION_MAX_PAGES=20
VISION_RENDER_DPI=150

# Storage & upload limits
STORAGE_DIR=./var/uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=60
MAX_IMAGE_PIXELS=40000000
DEFAULT_RETENTION_DAYS=7

# Document extraction
DOCLING_ENABLED=true
DOCLING_TABLE_STRUCTURE=true
SCANNED_PAGE_CHAR_THRESHOLD=40

# Background worker: true runs it inside the API process; set false when running
# `python -m app.jobs.worker` separately (docker compose does this).
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=1.0
RETENTION_SWEEP_SECONDS=300

# Sessions / HTTP
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3020"]
